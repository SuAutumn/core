{
  "name": "modernjs-ssr-dynamic-remote",
  "private": true,
  "version": "0.1.36",
  "scripts": {
    "build": "rslib build",
    "serve": "rslib mf-dev",
    "dev": "rslib mf-dev"
  },
  "engines": {
    "node": ">=16.18.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "node --max_old_space_size=8192 ./node_modules/eslint/bin/eslint.js --fix --color --cache --quiet"
    ]
  },
  "eslintIgnore": [
    "node_modules/",
    "dist/"
  ],
  "devDependencies": {
    "@rsbuild/core": "^1.3.21",
    "@rsbuild/plugin-react": "^1.1.1",
    "@rslib/core": "^0.9.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "~18.3.1",
    "typescript": "^5.7.3",
    "@types/node": "^22.13.9",
    "@module-federation/rsbuild-plugin": "workspace:*",
    "antd": "4.24.15",
    "react": "~18.3.1",
    "react-dom": "~18.3.1"
  }
}
